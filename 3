t=int(input())
for _ in range(t):
    s=input()
    regular=True
    n=len(s)
    cnt=0
    for i in range(n):
        if s[i]=='(':
            cnt+=1
        else:
            cnt-=1
        if cnt<0:
            regular=False
            break
    if regular or cnt>0:
        print("NO")
        continue
    print("YES")
    for i in range(2*n):
        if i%2==0:
            print('(',end="")
        else:
            print(')',end="")
    print("")
