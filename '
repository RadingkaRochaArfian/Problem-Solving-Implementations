from collections import deque
import sys


n,s=map(int,input().split(' '))
a=[0]+list(map(int,input().split(' ')))
b=[0]+list(map(int,input().split(" ")))
start=(1,1)
queue=deque([start])
visited={start}
while queue:
    node=queue.popleft()
    if node[1]==s:
        print('YES')
        sys.exit()
    if node[0]==1:
        for i in range(node[0]+1,n+1):
            if a[i]==1:
                state=(i,1)
                if state not in visited:
                    visited.add(state)